---

const { icon = 'included', title, class: className, ...rest } = Astro.props;

---

<details class="flex flex-col">
  <summary class="flex gap-9 justify-between items-center cursor-pointer select-none">
    <div class="flex gap-14">
      <slot name="icon" />
      <p class="text-electric font-semibold text-16 md:text-21">{title}</p>
    </div>
    <svg class="[[open]_&]:hidden w-24 h-24 shrink-0" xmlns="http://www.w3.org/2000/svg" height="24px" viewBox="0 -960 960 960" width="24px" fill="#FF9D0A">
      <path d="M504-480 320-664l56-56 240 240-240 240-56-56 184-184Z"/>
    </svg>
    <svg class="hidden [[open]_&]:block w-24 h-24 shrink-0" xmlns="http://www.w3.org/2000/svg" height="24px" viewBox="0 -960 960 960" width="24px" fill="#FF9D0A">
      <path d="M480-344 240-584l56-56 184 184 184-184 56 56-240 240Z"/>
    </svg>
  </summary>
  <div class="flex flex-col ps-38 md:ps-46 pt-9 md:pt-4 pb-9 pe-9 gap-20 text-parchment">
    <slot />
  </div>
</details>