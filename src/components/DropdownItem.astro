---
import MenuLink from "./MenuLink.astro"

const pageUrl = Astro.url.pathname;
---

<li data-dropdown class='relative group'>
  <MenuLink id="header-menu-dropdown-link" data-dropdown-trigger link="#" class="py-9" aria-haspopup="true" aria-controls="header-menu-dropdown" aria-expanded="false">Services</MenuLink>

  <div id="header-menu-dropdown" data-dropdown-menu class="flex absolute z-10 -left-22 top-full pt-12 invisible opacity-0 group-hover:visible 
  group-hover:opacity-100 transition-all duration-150 ease-out 
  [[data-open]_&]:visible [[data-open]_&]:opacity-100" aria-hidden="true" aria-labelledby="header-menu-dropdown-link">

    <ul class="flex flex-col shrink-0 gap-9 p-22 pe-36 bg-charcoal rounded-md border-[1.5px] border-electric">
      <MenuLink link="/custom-website-design/" color="white"  aria-current={pageUrl === "/custom-website-design/" ? "page" : undefined}>Website Design</MenuLink>
      <MenuLink link="/website-support-plans/" color="white" aria-current={pageUrl === "/website-support-plans/" ? "page" : undefined}>Website Support</MenuLink>
    </ul>

  </div>
</li>
