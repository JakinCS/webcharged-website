---
// @ts-nocheck

const { fixedWidth = {}, mobileWidth, link = undefined, class: className, ...rest } = Astro.props;

const { isFixed = false, maxWidthClass = 'max-w-300', breakpoint = 'none'} = fixedWidth;

const breakpointWidthMap = {
  'none': 'w-full',
  'sm':   'w-full sm:w-fit',
  'md':   'w-full md:w-fit',
  'lg':   'w-full lg:w-fit',
  'xl':   'w-full xl:w-fit'
};

const baseStyles = "px-20 md:px-44 lg:px-36 rounded-md bg-spark text-charcoal text-19 lg:text-21 font-semibold py-14 lg:py-9"

const type1Styles = (!className?.includes('hidden') ? 'inline-flex ' : "") + 'items-center justify-center max-w-[100%] box-border before:w-24 before:md:w-0 before:min-w-0 before:flex-grow-0 before:flex-shrink-9999 before:flex-basis-24 before:md:flex-basis-0 after:w-24 after:md:w-0 after:min-w-0 after:flex-grow-0 after:flex-shrink-9999 after:flex-basis-24 after:md:flex-basis-0';

const type2Styles = (breakpointWidthMap[breakpoint] ?? 'w-full') + ' text-center ' + maxWidthClass;

const nonLinkButtonStyles = 'cursor-pointer disabled:cursor-not-allowed disabled:opacity-75';

const buttonStyles = baseStyles + " " + (isFixed ? " " + type2Styles : " " + type1Styles) + (link === undefined ? " " + nonLinkButtonStyles : '') + (className ? " " + className : "");

---

{link === undefined ? 
  <button class={buttonStyles} {...rest}>
    {isFixed ? 
      <slot />
    :
      <span class="shrink-1 text-center"><slot /></span>
    }
  </button> 
  : 
  <a href={link} class={buttonStyles} {...rest}>
    {isFixed ? 
      <slot />
    :
      <span class="shrink-1 text-center"><slot /></span>
    }
  </a>
}


<style>
  a, button:not([disabled]) {
    &:hover, &:focus-visible, &:active {
      background: var(--color-spark-400);
    }
  }
</style>
