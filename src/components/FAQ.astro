---

const { title = "Lorem Ipsum" } = Astro.props;

---


<details class="flex flex-col border-b-[1.5px] border-parchment/25">
  <summary class="flex justify-between items-center gap-12 md:gap-22 lg:gap-34 py-20 cursor-pointer">
    <p class="text-16 md:text-19 lg:text-21 font-semibold text-parchment">{title}</p>
    <svg class="[[open]_&]:hidden w-24 h-24 shrink-0" width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
      <path d="M0 12H24" stroke="#FFF7EB" stroke-width="2.5"/>
      <path d="M12 0L12 24" stroke="#FFF7EB" stroke-width="2.5"/>
    </svg>
    <svg class="hidden [[open]_&]:block w-24 h-24 shrink-0" width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
      <path d="M0 12H24" stroke="#FFF7EB" stroke-width="2.5"/>
    </svg>
  </summary>
  <div class="flex flex-col pe-32 md:pe-59 pb-20 gap-20 text-parchment">
    <slot />
  </div>
</details>