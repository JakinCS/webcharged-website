---

<MainLayout headContent={headContent}>
  <section class="flex justify-center bg-blue-gradient px-32 md:px-53 lg:px-59 py-138 md:py-223 lg:py-249">
    <div class="grow-1 flex flex-col max-w-1281">
      <H1>Frequently Asked Questions</H1>
    </div>
  </section>
  <section class="flex justify-center px-32 md:px-53 lg:px-59 py-85 md:py-95">
    <div class="grow-1 flex flex-col gap-59 md:gap-95 max-w-1281">
      <H2 class="md:text-center">Website design and development</H2>
      <div class="flex flex-col gap-12 md:gap-14">
        <H3>General Service Questions</H3>
        <div class="toggle-group flex flex-col">
          {generalServiceQuestions.map((faq) => (
            <FAQ title={faq.title} >
              {faq.content.map((block) => (
                <p set:html={block} />
              ))}
            </FAQ>
          ))}
        </div>
      </div>
      <div class="flex flex-col gap-12 md:gap-14">
        <H3>Design & Development Process</H3>
        <div class="toggle-group flex flex-col">
          {designDevelopmentProcess.map((faq) => (
            <FAQ title={faq.title} >
              {faq.content.map((block) => (
                <p set:html={block} />
              ))}
            </FAQ>
          ))}
        </div>
      </div>
      <div class="flex flex-col gap-12 md:gap-14">
        <H3>Content & Features</H3>
        <div class="toggle-group flex flex-col">
          {contentFeatures.map((faq) => (
            <FAQ title={faq.title} >
              {faq.content.map((block) => (
                <p set:html={block} />
              ))}
            </FAQ>
          ))}
        </div>
      </div>
      <div class="flex flex-col gap-12 md:gap-14">
        <H3>Technical & SEO Questions</H3>
        <div class="toggle-group flex flex-col">
          {technicalSEOQuestions.map((faq) => (
            <FAQ title={faq.title} >
              {faq.content.map((block) => (
                <p set:html={block} />
              ))}
            </FAQ>
          ))}
        </div>
      </div>
      <div class="flex flex-col gap-12 md:gap-14">
        <H3>Hosting & Support</H3>
        <div class="toggle-group flex flex-col">
          {hostingSupport.map((faq) => (
            <FAQ title={faq.title} >
              {faq.content.map((block) => (
                <p set:html={block} />
              ))}
            </FAQ>
          ))}
        </div>
      </div>
      <div class="flex flex-col gap-12 md:gap-14">
        <H3>Business & Investment Questions</H3>
        <div class="toggle-group flex flex-col">
          {businessInvestmentQuestions.map((faq) => (
            <FAQ title={faq.title} >
              {faq.content.map((block) => (
                <p set:html={block} />
              ))}
            </FAQ>
          ))}
        </div>
      </div>
    </div>
  </section>
  <section class="flex justify-center px-32 md:px-53 lg:px-59 py-85 md:py-95">
    <div class="grow-1 flex flex-col gap-59 md:gap-95 max-w-1281">
      <H2 class="md:text-center">Website support plans</H2>
      <div class="flex flex-col gap-12 md:gap-14">
        <H3>General Service Questions</H3>
        <div class="toggle-group flex flex-col">
          {sGeneralServiceQuestions.map((faq) => (
            <FAQ title={faq.title} >
              {faq.content.map((block) => (
                <p set:html={block} />
              ))}
            </FAQ>
          ))}
        </div>
      </div>
      <div class="flex flex-col gap-12 md:gap-14">
        <H3>Reporting & Communication Questions</H3>
        <div class="toggle-group flex flex-col">
          {sReportingCommunicationQuestions.map((faq) => (
            <FAQ title={faq.title} >
              {faq.content.map((block) => (
                <p set:html={block} />
              ))}
            </FAQ>
          ))}
        </div>
      </div>
      <div class="flex flex-col gap-12 md:gap-14">
        <H3>Business Value Questions</H3>
        <div class="toggle-group flex flex-col">
          {sBusinessValueQuestions.map((faq) => (
            <FAQ title={faq.title} >
              {faq.content.map((block) => (
                <p set:html={block} />
              ))}
            </FAQ>
          ))}
        </div>
      </div>
      <div class="flex flex-col gap-12 md:gap-14">
        <H3>Pricing & Contract Questions</H3>
        <div class="toggle-group flex flex-col">
          {sPricingContractQuestions.map((faq) => (
            <FAQ title={faq.title} >
              {faq.content.map((block) => (
                <p set:html={block} />
              ))}
            </FAQ>
          ))}
        </div>
      </div>
    </div>
  </section>
  <script>
    import '../scripts/toggle-script.js'
  </script>
</MainLayout>