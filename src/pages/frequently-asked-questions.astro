---
import MainLayout from "../layouts/MainLayout.astro";
import H1 from "../components/text/H1.astro";
import H2 from "../components/text/H2.astro";
import H3 from "../components/text/H3.astro";
import FAQ from "../components/FAQ.astro";

const schemaMarkup = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "FAQPage",
      "@id": "https://webchargedsolutions.com/frequently-asked-questions/#webpage",
      "url": "https://webchargedsolutions.com/frequently-asked-questions",
      "name": "Frequently Asked Questions (FAQ) - Webcharged Web Solutions",
      "description": "Read the Frequently Asked Questions (FAQs) about our popular services including our Website Design and Development service and our Website Support service.",
      "isPartOf": { "@id": "https://webchargedsolutions.com/#organization" },
      "breadcrumb": { "@id": "https://webchargedsolutions.com/frequently-asked-questions/#breadcrumb" },
      "mainEntity": [
        {
          "@type": "Question",
          "name": "How long does it take to build a website?",
          "acceptedAnswer": { "@type": "Answer", "text": "For an average project: Planning (1–2 weeks), Production (6–8 weeks), and Launch (1 week)." }
        },
        {
          "@type": "Question",
          "name": "Do I own my website after it has been completed?",
          "acceptedAnswer": { "@type": "Answer", "text": "Yes, once paid for, you own all design files, content, code, and login credentials." }
        },
        {
          "@type": "Question",
          "name": "What payment methods do you accept?",
          "acceptedAnswer": { "@type": "Answer", "text": "We accept credit cards or bank transfers." }
        },
        {
          "@type": "Question",
          "name": "What do you need from me to get started?",
          "acceptedAnswer": { "@type": "Answer", "text": "The first step is a project planning call. We collect business goals, target audience, and brand guidelines one week before the project starts." }
        },
        {
          "@type": "Question",
          "name": "Will I see what my website will look like before development begins?",
          "acceptedAnswer": { "@type": "Answer", "text": "Yes, we provide custom mockups and prototypes for your approval before coding starts." }
        },
        {
          "@type": "Question",
          "name": "Will my website work and look good on mobile phones and tablets?",
          "acceptedAnswer": { "@type": "Answer", "text": "Yes, all websites are built to be mobile-friendly and responsive for all screen sizes." }
        },
        {
          "@type": "Question",
          "name": "Do I need to write the content for my website, or do you provide it?",
          "acceptedAnswer": { "@type": "Answer", "text": "We provide professional copywriting as part of our service, gathering the necessary details from you." }
        },
        {
          "@type": "Question",
          "name": "What happens if I don't have professional photos for my website?",
          "acceptedAnswer": { "@type": "Answer", "text": "We help you via coaching, sourcing high-quality stock photos, or assisting in hiring a pro photographer." }
        },
        {
          "@type": "Question",
          "name": "Will my website be optimized for search engines (SEO)?",
          "acceptedAnswer": { "@type": "Answer", "text": "We perform comprehensive on-page SEO so your site is ready for SEO success if you choose to invest in off-page SEO." }
        },
        {
          "@type": "Question",
          "name": "How fast will my website load?",
          "acceptedAnswer": { "@type": "Answer", "text": "We create hand-coded websites that by nature are incredibly fast. But if you need a WordPress website, speeds will vary, but we use fast hosting and image optimization to ensure industry-standard performance." }
        },
        {
          "@type": "Question",
          "name": "Where will my website be hosted?",
          "acceptedAnswer": { "@type": "Answer", "text": "We host our hand-coded websites on CloudFlare Pages. If you require a WordPress website, it will be hosted on one of our Hetzner servers. 1 year of hosting is included ($25/month thereafter or $40/month for WordPress websites)." }
        },
        {
          "@type": "Question",
          "name": "What kind of support do you provide after my website launches?",
          "acceptedAnswer": { "@type": "Answer", "text": "We provide 12 months of free support for bug fixes, minor updates, and questions." }
        },
        {
          "@type": "Question",
          "name": "What if I need work done beyond minor content updates?",
          "acceptedAnswer": { "@type": "Answer", "text": "Major updates and new features are available at a rate of $50/hour." }
        },
        {
          "@type": "Question",
          "name": "What happens if something breaks on my website?",
          "acceptedAnswer": { "@type": "Answer", "text": "We fix any issues at no charge for the first year. Post-year-one, we recommend our support plans." }
        },
        {
          "@type": "Question",
          "name": "Why should I invest in a modern website for my business?",
          "acceptedAnswer": { "@type": "Answer", "text": "Professional design builds credibility in 0.05 seconds and can increase conversion rates by over 400%." }
        },
        {
          "@type": "Question",
          "name": "What makes you different from other web design companies?",
          "acceptedAnswer": { "@type": "Answer", "text": "We offer a personal, local partnership in Yuma, AZ, with a pain-free process and custom-tailored solutions." }
        },
        {
          "@type": "Question",
          "name": "Can you work with my existing marketing team or other vendors?",
          "acceptedAnswer": { "@type": "Answer", "text": "Yes, we are happy to coordinate with your other specialists to ensure all efforts align." }
        },
        {
          "@type": "Question",
          "name": "What type of businesses do you work with?",
          "acceptedAnswer": { "@type": "Answer", "text": "We primarily serve small businesses across a wide range of industries." }
        },
        {
          "@type": "Question",
          "name": "Do you work with businesses outside of Yuma?",
          "acceptedAnswer": { "@type": "Answer", "text": "Absolutely. We work with clients anywhere via our fully online workflow." }
        },
        {
          "@type": "Question",
          "name": "Will you support a website that you didn't originally build?",
          "acceptedAnswer": { "@type": "Answer", "text": "Yes, we support outside websites for a one-time $200 startup fee." }
        },
        {
          "@type": "Question",
          "name": "How fast is your response time to content change requests?",
          "acceptedAnswer": { "@type": "Answer", "text": "We typically complete these requested changes in 1-2 business days. It can take longer depending on how much needs changing." }
        },
        {
          "@type": "Question",
          "name": "What happens if I need a major update to my website?",
          "acceptedAnswer": { "@type": "Answer", "text": "Extensive updates or new features are billed at $50/hour." }
        },
        {
          "@type": "Question",
          "name": "What information is provided in your monthly reports?",
          "acceptedAnswer": { "@type": "Answer", "text": "Reports include traffic, performance, health metrics, and summaries of any changes or fixes made." }
        },
        {
          "@type": "Question",
          "name": "How will you communicate with me about website issues?",
          "acceptedAnswer": { "@type": "Answer", "text": "Urgent issues are communicated immediately; minor fixes are detailed in your monthly report." }
        },
        {
          "@type": "Question",
          "name": "Can I request specific updates or changes to my website?",
          "acceptedAnswer": { "@type": "Answer", "text": "Yes, making content modifications is a core part of our support plans." }
        },
        {
          "@type": "Question",
          "name": "Why does my website need website maintenance?",
          "acceptedAnswer": { "@type": "Answer", "text": "Maintenance keeps your site fast and secure, preventing broken features and lost conversions." }
        },
        {
          "@type": "Question",
          "name": "What happens if my website gets hacked?",
          "acceptedAnswer": { "@type": "Answer", "text": "This is unlikely with hand-coded websites. But if it does happen, we will restore your site and implement necessary security measures immediately." }
        },
        {
          "@type": "Question",
          "name": "Is website support really worth the cost?",
          "acceptedAnswer": { "@type": "Answer", "text": "Yes, it provides peace of mind, ensures peak performance, and protects your business's online impact." }
        },
        {
          "@type": "Question",
          "name": "Are there any long-term contracts required?",
          "acceptedAnswer": { "@type": "Answer", "text": "No, you can cancel your website support plan at any time." }
        },
        {
          "@type": "Question",
          "name": "Why might prices be higher depending on the website?",
          "acceptedAnswer": { "@type": "Answer", "text": "Complexity, age, or high number of plugins (if built on WordPress) can increase the time required for proper maintenance." }
        },
        {
          "@type": "Question",
          "name": "What if I'm not satisfied with the service?",
          "acceptedAnswer": { "@type": "Answer", "text": "We aim for 100% satisfaction and are always open to discussing issues to improve your experience." }
        }
      ]
    },
    {
      "@type": "BreadcrumbList",
      "@id": "https://webchargedsolutions.com/frequently-asked-questions/#breadcrumb",
      "itemListElement": [
        {
          "@type": "ListItem",
          "position": 1,
          "name": "Home",
          "item": "https://webchargedsolutions.com/"
        },
        {
          "@type": "ListItem",
          "position": 2,
          "name": "FAQ"
        }
      ]
    },
    {
      "@type": "LocalBusiness",
      "@id": "https://webchargedsolutions.com/#organization",
      "name": "WebCharged Web Solutions",
      "address": {
        "@type": "PostalAddress",
        "addressLocality": "Yuma",
        "addressRegion": "AZ",
        "addressCountry": "US"
      }
    }
  ]
}

const headContent = {
