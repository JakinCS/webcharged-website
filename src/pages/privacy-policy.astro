---
// @ts-nocheck

import '../styles/policy.css'
import MainLayout from "../layouts/MainLayout.astro";
import H1 from "../components/text/H1.astro";


const headContent = {
  metaTitle: "Privacy Policy - WebCharged Web Solutions",
  metaDescription: 'We value your privacy very highly. Our Privacy Policy contains information about your privacy. By accessing the Website, you agree to the Privacy Policy.',
}

---

<MainLayout headContent={headContent}>
  <link slot="head" rel="preconnect" href="https://embed.termageddon.com" />
  <link slot="head" rel="preconnect" href="https://policies.termageddon.com" />
  <link slot="head" rel="dns-prefetch" href="https://embed.termageddon.com" />
  <link slot="head" rel="dns-prefetch" href="https://policies.termageddon.com" />

  <section class="flex flex-col items-center px-32 md:px-53 lg:px-59 py-53 md:py-95 gap-20 md:gap-36">
    <H1 color="blue">Privacy Policy</H1>
    <div id="embed-container" class="embed-container grow-1 min-h-1000 w-full max-w-1281">

      <div id="YUdGM1lsUlJhVmRqY0VOR1NVRTlQUT09" class="policy_embed_div" width="640" height="480"> 
        <div class="flex flex-col gap-16 mt-16 mb-59">
          <p>
            We value your privacy very highly. Please read this Privacy Policy carefully before using the webchargedsolutions.com 
            website (the “Website”) operated by WebCharged Web Solutions LLC, a(n) Limited Liability Company formed in Arizona, 
            United States (“us, we, our”) as this Privacy Policy contains important information regarding your privacy 
            and how we may use the information we collect about you.
          </p>
          <p>
            Your access to or use of the Website is conditional upon your acceptance of and compliance with this Privacy Policy. 
            This Privacy Policy applies to everyone, including but not limited to visitors, users and others, 
            who wish to access or use the Website.
          </p>
          <p>
            By accessing or using the Website, you agree to be bound by this Privacy Policy. 
            If you disagree with any part of this Privacy Policy, you do not have our permission to access or use the Website.
          </p>
        </div>
        <div>
          Please wait while the policy is loaded. If it does not load, please 
          <a rel="nofollow" href="https://policies.termageddon.com/api/policy/YUdGM1lsUlJhVmRqY0VOR1NVRTlQUT09" target="_blank">click here</a> 
          to view the policy.
        </div>
        
      </div>
      <script src="https://policies.termageddon.com/api/embed/YUdGM1lsUlJhVmRqY0VOR1NVRTlQUT09.js"></script>

    </div>
  </section>
</MainLayout>

