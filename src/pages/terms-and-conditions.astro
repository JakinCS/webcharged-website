---
// @ts-nocheck

import '../styles/policy.css'
import MainLayout from "../layouts/MainLayout.astro";
import H1 from "../components/text/H1.astro";


const headContent = {
  metaTitle: "Terms & Conditions - WebCharged Web Solutions",
  metaDescription: 'This Terms of Service contains important information regarding limitations of the liability of WebCharged Web Solutions.',
}

---

<MainLayout headContent={headContent}>
  <section class="flex flex-col items-center px-32 md:px-53 lg:px-59 py-53 md:py-95 gap-20 md:gap-36">
    <H1 color="blue">Terms and Conditions</H1>
    <div id="embed-container" class="embed-container grow-1 w-full max-w-1281">

      <div id="U0hGM1FUVm1NM0F4WkhsQlNrRTlQUT09" class="policy_embed_div" width="640" height="480"> 
        Please wait while the policy is loaded. If it does not load, please 
        <a rel="nofollow" href="https://policies.termageddon.com/api/policy/U0hGM1FUVm1NM0F4WkhsQlNrRTlQUT09" target="_blank">click here</a> 
        to view the policy.
      </div>
      <script src="https://policies.termageddon.com/api/embed/U0hGM1FUVm1NM0F4WkhsQlNrRTlQUT09.js"></script>

    </div>
  </section>
</MainLayout>

