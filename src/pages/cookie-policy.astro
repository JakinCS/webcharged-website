---
// @ts-nocheck

import '../styles/policy.css'
import MainLayout from "../layouts/MainLayout.astro";
import H1 from "../components/text/H1.astro";


const headContent = {
  metaTitle: "Cookie Policy - WebCharged Web Solutions",
  metaDescription: 'View our Cookie Policy. We value your privacy very highly. You may choose to accept or deny the non-necessary cookies we use.',
}

---

<MainLayout headContent={headContent}>
  <section class="flex flex-col items-center px-32 md:px-53 lg:px-59 py-53 md:py-95 gap-20 md:gap-36">
    <H1 color="blue">Cookie Policy</H1>
    <div id="embed-container" class="embed-container grow-1 w-full max-w-1281">

      <div id="UWxwQlJFTXZka2t3UkVOb09GRTlQUT09" class="policy_embed_div" width="640" height="480"> 
        Please wait while the policy is loaded. If it does not load, please <a rel="nofollow" href="https://policies.termageddon.com/api/policy/UWxwQlJFTXZka2t3UkVOb09GRTlQUT09" target="_blank">click here</a> to view the policy.
      </div>
      <script src="https://policies.termageddon.com/api/embed/UWxwQlJFTXZka2t3UkVOb09GRTlQUT09.js"></script>

    </div>
  </section>
</MainLayout>

