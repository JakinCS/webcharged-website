---
import MainLayout from "../layouts/MainLayout.astro"
import Button from "../components/Button.astro"
import Text from "../components/text/Text.astro"
import H1 from "../components/text/H1.astro";
import H2 from '../components/text/H2.astro';
import H3 from '../components/text/H3.astro';
import ServiceDetailsToggle from "../components/ServiceDetailsToggle.astro";
import FAQ from '../components/FAQ.astro';

const schemaMarkup = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebPage",
      "@id": "https://webchargedsolutions.com/custom-website-design/#webpage",
      "url": "https://webchargedsolutions.com/custom-website-design",
      "name": "Custom Website Design for Small Businesses | WebCharged Web Solutions",
      "isPartOf": { "@id": "https://webchargedsolutions.com/#organization" },
      "description": "Get a custom website that increases your revenue through a higher visitor-to-customer conversion rate. Based in Yuma, AZ.",
      "breadcrumb": { "@id": "https://webchargedsolutions.com/custom-website-design/#breadcrumb" }
    },
    {
      "@type": "BreadcrumbList",
      "@id": "https://webchargedsolutions.com/custom-website-design/#breadcrumb",
      "itemListElement": [
        {
          "@type": "ListItem",
          "position": 1,
          "name": "Home",
          "item": "https://webchargedsolutions.com/"
        },
        {
          "@type": "ListItem",
          "position": 2,
          "name": "Custom Website Design"
        }
      ]
    },
    {
      "@type": "Service",
      "@id": "https://webchargedsolutions.com/custom-website-design/#service",
      "name": "Custom Website Design",
      "serviceType": "Web Design and Development",
      "provider": { "@id": "https://webchargedsolutions.com/#organization" },
      "areaServed": { "@type": "Place", "name": "Worldwide" },
      "description": "A professional website built for maximum conversions focusing on content, mobile-friendliness, speed, and captivating design.",
      "offers": {
        "@type": "Offer",
        "price": "2995.00",
        "priceCurrency": "USD",
        "url": "https://webchargedsolutions.com/custom-website-design",
        "description": "Custom website design package including copywriting, photo assistance, and 12 months of support.",
        "availability": "https://schema.org/InStock"
      },
      "hasOfferCatalog": {
        "@type": "OfferCatalog",
        "name": "Custom Website Features",
        "itemListElement": [
          { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "Copywriting" } },
          { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "Mobile-Friendly Development" } },
          { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "Speed Optimization" } },
          { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "Analytics Setup" } },
          { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "12 Months Post-Launch Support" } }
        ]
      }
    },
    {
      "@type": "Person",
      "@id": "https://webchargedsolutions.com/#jakinstahl",
      "name": "Jakin Stahl",
      "jobTitle": "Owner, Designer, and Developer",
      "worksFor": { "@id": "https://webchargedsolutions.com/#organization" },
      "image": "https://webchargedsolutions.com/wp-content/uploads/2026/02/headshot-owner-jakin-stahl.webp"
    },
    {
      "@type": "FAQPage",
      "@id": "https://webchargedsolutions.com/custom-website-design/#faq",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "How long does it take to build a website?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "For an average project, the timeline is 1-2 weeks for planning, 6-8 weeks for production, and 1 week for wrap-up and launch."
          }
        },
        {
          "@type": "Question",
          "name": "What do you need from me to get started?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "All you need to do is schedule a project planning call. We handle the rest, including content and photo assistance."
          }
        },
        {
          "@type": "Question",
          "name": "What if I change my mind?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "We offer a zero-risk guarantee. You can cancel before the project starts for a 100% refund, or before development begins if the mockup is unsatisfactory."
          }
        },
        {
          "@type": "Question",
          "name": "What forms of payment do you accept?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "We accept credit cards and bank transfers."
          }
        }
      ]
    }
  ]
}

const headContent = {
  metaTitle: "Custom website design - Increase your revenue today",
  metaDescription: 'Web design service for small businesses based in Yuma, AZ. A simple process to build a successful website that increases your profits.',
  schemaMarkup,
  socialMediaImagePath: '/images/social/Website-Design-Facebook.jpg',
  socialMediaImageDesc: "WebCharged. We provide custom website design that grows your small business.",
  twitterImagePath: '/images/social/Website-Design-Twitter.jpg',
}

const FAQs = [
  {
    title: "How long does it take to build a website?",
    content: [
      "The time it takes to build a website varies on the size and scope of the project.\
       For an average website project you might expect the timeline to look like this:",
      "Planning phase: 1 – 2 weeks<br>Production phase: 6 – 8 weeks<br>Wrap up and launch: 1 week"       
    ]
  },
  {
    title: "What do you need from me to get started?",
    content: [
      "All you need to do is schedule a project planning call. This is the first step. After that, we work on collecting from you all the information we need to complete the project."       
    ]
  },
  {
    title: "What forms of payment do you accept?",
    content: [
      "We accept multiple payment methods. You can pay via credit card or bank transfer."       
    ]
  },
  {
    title: "What if I change my mind?",
    content: [
      "If you change your mind, you can cancel the project, and we’ll refund you 100% of your money. And if you dislike the website design, you can request a refund anytime before the website design is finalized."       
    ]
  },
  {
    title: "What happens if I make a late payment?",
    content: [
      "We understand that certain circumstances can cause late payments. So we give a 5 business day grace period to complete the payment. After that, we charge a $50 fee."       
    ]
  },
]

---

<MainLayout headContent={headContent} headerButtonLink='#schedule-call-section'>
  <link slot="head" rel="preconnect" href="https://app.cal.com" crossorigin />
  <link slot="head" rel="dns-prefetch" href="https://app.cal.com" />

  <section class="flex justify-center bg-blue-gradient px-32 md:px-53 lg:px-59 py-85 md:py-154">
    <div class="grow-1 flex flex-col gap-32 md:gap-36 max-w-1281">
      <div class="flex flex-col gap-20 md:gap-36">
        <div class="flex items-center gap-5">
          <img class="w-20 md:w-24" src="/icons/pin-white.svg" alt="location pin" width="24" height="24">
          <p class="text-16 md:text-21 text-parchment">Based in Yuma, AZ.</p>
        </div>
        <H1 class="max-w-400 md:max-w-500 lg:max-w-600">Custom Website Design for Small Businesses</H1>
        <Text class="text-parchment max-w-350 md:max-w-400 lg:max-w-450">
          Get a website that increases your revenue by having a higher website conversion rate.
        </Text>
      </div>
      <Button link="#schedule-call-section" class='self-start'>Expand your profits today</Button>
    </div>
  </section>
  <section class="flex justify-center lg:px-95 overflow-hidden">
    <div class="grow-1 flex flex-col lg:flex-row gap-20 md:gap-38 lg:gap-54 max-w-1281">

      <div class="lg:basis-486 lg:grow-1 flex flex-col gap-20 md:gap-36 px-32 md:px-95 lg:px-0 pb-32 pt-53 md:pb-53 md:pt-95 lg:py-95 bg-blue">
        <H2 color="parchment">Lots of effort, <span class="text-electric">not enough</span> results</H2>
        <div class="flex flex-col gap-22">
          <Text class="text-parchment">
            This happens a lot. You’ve got a website, and you’ve invested time and money into it. 
            You expect the website to really help you increase your revenue, but it doesn’t meet your expectations. 
          </Text>
          <Text class="text-parchment">
            You have a great business. 
            People love working with you or buying your products. 
            So you expect your website to attract new customers and clients.
          </Text>
          <Text class="text-parchment">
            But it doesn’t. 
            Worse yet, it might even dissuade potential customers instead of persuade them. 
          </Text>
        </div>
      </div>

      <div>
        <div class="triangle-separator absolute w-0 h-0 -z-1 
        -translate-y-20 md:-translate-y-38 lg:-translate-y-0 lg:-translate-x-54 
        border-t-40 md:border-t-76 lg:border-t-800 xl:border-t-700 
        border-s-[100vw] lg:border-s-0 lg:border-e-108 border-[transparent] border-t-blue"></div>
        <div class="beginning-block absolute w-1000 h-1000 bg-blue -translate-x-1300 -z-1 hidden md:block"></div>
      </div>

      <div class="lg:basis-615 lg:grow-1 flex flex-col gap-20 md:gap-36 px-32 md:px-95 lg:px-0 lg:ps-36 pt-32 pb-53 md:pt-53 md:pb-95 lg:py-95">
        <H2>A good website <span class="text-spark">increases your revenue</span></H2>
        <div class="flex flex-col gap-22">
          <Text>
            Having a great business is the foundation for a successful website. 
            But when the website doesn’t convert, it’s the website’s problem, not the business itself.
          </Text>
          <Text>
            If you build a website the right way, you will see these results:
          </Text>
          <div class="flex flex-col gap-14">
            <div class="flex gap-18 ps-18">
              <div class="pt-8 md:pt-11 lg:pt-12">
                <svg width="8" height="8" viewBox="0 0 8 8" fill="none" xmlns="http://www.w3.org/2000/svg">
                  <circle cx="4" cy="4" r="4" fill="#222F2F"/>
                </svg>
              </div>
              <Text>You will stop repelling potential clients or customers.</Text>
            </div>
            <div class="flex gap-18 ps-18">
              <div class="pt-8 md:pt-11 lg:pt-12">
                <svg width="8" height="8" viewBox="0 0 8 8" fill="none" xmlns="http://www.w3.org/2000/svg">
                  <circle cx="4" cy="4" r="4" fill="#222F2F"/>
                </svg>
              </div>
              <Text>The conversion rates for your primary pages will increase.</Text>
            </div>
            <div class="flex gap-18 ps-18">
              <div class="pt-8 md:pt-11 lg:pt-12">
                <svg width="8" height="8" viewBox="0 0 8 8" fill="none" xmlns="http://www.w3.org/2000/svg">
                  <circle cx="4" cy="4" r="4" fill="#222F2F"/>
                </svg>
              </div>
              <Text>You will receive more business. And <span class="text-spark font-semibold">this means increased revenue</span>.</Text>
            </div>
          </div>
        </div>
      </div>

    </div>
  </section>
  <section class="flex flex-col items-center bg-charcoal px-32 md:px-59 py-53 lg:py-95 gap-36">
    <H2 color="electric text-center">The formula for maximum conversions</H2>
    <Text class="text-parchment">A professional website, one that turns visitors in customers well, is created by focusing on these four things:</Text>
    <div class="grow-1 flex flex-col items-center md:items-start justify-center md:flex-row gap-59 max-w-559 md:max-w-630 lg:max-w-1281 lg:w-full">
      <div class="flex flex-col gap-36 lg:gap-0 lg:w-full">
        <div class="flex flex-col md:flex-row items-center md:items-start gap-28 py-20 md:py-36 md:px-36 lg:w-630">
          <img class="w-52 lg:w-72 pt-8" src="/icons/big-number-one-electric.svg" alt="Number one" width="72" height="84"/>
          <div class="flex flex-col items-center md:items-start gap-9">
            <H3 color='electric'>Content</H3> 
            <Text class="text-parchment">
              Good copy convinces. The right photos engage. 
              Using effective CTAs makes people more likely to take action. 
            </Text>
            <Text class="text-parchment">
              Your website content is the #1 important thing to get right. 
              Without it, visitors leave your website unconvinced.
            </Text>
          </div>
        </div>
        <div class="lg:self-end flex flex-col md:flex-row items-center md:items-start gap-28 py-20 md:py-36 md:px-36 lg:w-630 lg:-mt-10 xl:-mt-70">
          <img class="w-52 lg:w-72 pt-8" src="/icons/big-number-two-electric.svg" alt="Number two" width="72" height="84"/>
          <div class="flex flex-col items-center md:items-start gap-9">
            <H3 color='electric'>Mobile-friendliness</H3> 
            <Text class="text-parchment">
              Roughly 50% of website visitors use their phones. 
              These visitors expect your website work perfectly on their device. 
              If not, they are very likely to go somewhere else. 
            </Text>
            <Text class="text-parchment">
              Having a non-mobile-friendly website gives them a negative impression of your business.
            </Text>
          </div>
        </div>
        <div class="flex flex-col md:flex-row items-center md:items-start gap-28 py-20 md:py-36 md:px-36 lg:w-630 lg:-mt-10 xl:-mt-70">
          <img class="w-52 lg:w-72 pt-8" src="/icons/big-number-three-electric.svg" alt="Number three" width="72" height="84"/>
          <div class="flex flex-col items-center md:items-start gap-9">
            <H3 color='electric'>Fast load speeds</H3> 
            <Text class="text-parchment">
              People will leave your website if it loads too slowly. 
              It annoys them. They lose patience. 
            </Text>
            <Text class="text-parchment">
              On the other hand, if your website is faster than average, it shows that it is <i>high-quality</i>. 
              And people will notice and think well of your business.
            </Text>
          </div>
        </div>
        <div class="lg:self-end flex flex-col md:flex-row items-center md:items-start gap-28 py-20 md:py-36 md:px-36 lg:w-630 lg:-mt-10 xl:-mt-70">
          <img class="w-52 lg:w-72 pt-8" src="/icons/big-number-four-electric.svg" alt="Number four" width="72" height="84"/>
          <div class="flex flex-col items-center md:items-start gap-9">
            <H3 color='electric'>Captivating design</H3> 
            <Text class="text-parchment">
              Your website’s design is the first thing that visitors notice. 
              It either captivates them or pushes them away.  
            </Text>
            <Text class="text-parchment">
              The design is a reflection of your business. 
              When the design is good, you become more trustable.
            </Text>
          </div>
        </div>
      </div>
    </div>
  </section>
  <section class="flex flex-col items-center xl:px-95">
    <div class="grow-1 flex flex-col lg:flex-row items-center py-22 lg:py-0 max-w-623 md:max-w-751 lg:max-w-1400 xl:max-w-1210">
      <div class="relative lg:basis-645 xl:basis-550 px-22 lg:ps-95 xl:ps-0 pb-22">
        <picture>
          <source
            media="(min-width: 1150px)"
            srcset="/images/headshot-owner-jakin-stahl-528x784.webp"
            width="528"
            height="784"
          />
          <img
            src="/images/headshot-owner-jakin-stahl-632x691.webp"
            alt="Headshot of the owner Jakin Stahl"
            width="416"
            height="455"
            loading="lazy"
            class="rounded-md w-316 md:w-416 lg:w-528 h-345 md:h-auto object-cover object-center"
          />
        </picture>
        <div class="absolute right-0 bottom-0 flex flex-row items-center gap-30 md:gap-36 bg-blue px-22 py-14 rounded-md">
          <div class="flex flex-col">
            <p class="text-16 md:text-23/[150%] lg:text-27/[150%] font-semibold text-parchment">Jakin Stahl</p>
            <p class="text-12 md:text-16 text-parchment">Owner, Designer and Developer</p>
          </div>
          <img class="w-34 md:w-56" src="/images/webcharged-icon-white.svg" alt="WebCharged icon" width="55" height="65">
        </div>
      </div>
      <div class="lg:basis-754 xl:basis-660 flex flex-col gap-59 px-32 md:px-53 lg:px-59 xl:pe-0 py-59">
        <div class="flex flex-col gap-36">
          <H2>Wesite design done for you</H2>
          <div class="flex flex-col gap-20">
            <Text>
              Are you tired of investing all your time into your website? 
              Let us do the website design for you. 
              Then you can focus on doing what you do best. 
            </Text>
            <Text>
              Here is what you’ll get:
            </Text>
          </div>
          <div class="flex flex-col gap-36">
            <div class="flex flex-col p-9 ps-36 gap-8 border-s-8 border-charcoal rounded-md">
              <h3 class="text-16 md:text-19 lg:text-21 font-semibold text-blue">Effective website content</h3>
              <Text>
                We will work together with you to create effective, high-converting content.
              </Text>
            </div>
            <div class="flex flex-col p-9 ps-36 gap-8 border-s-8 border-charcoal rounded-md">
              <h3 class="text-16 md:text-19 lg:text-21 font-semibold text-blue">High-quality, engaging designs</h3>
              <Text>
                You will have a custom design that fits your company. 
                Your design will start captivating visitors, making them want to keep browsing on your website.
              </Text>
            </div>
            <div class="flex flex-col p-9 ps-36 gap-8 border-s-8 border-charcoal rounded-md">
              <h3 class="text-16 md:text-19 lg:text-21 font-semibold text-blue">Professional website development</h3>
              <Text>
                Your website will be built to be fast. 
                It will works on all device screen sizes (mobile-friendly).
              </Text>
            </div>
          </div>

        </div>
        <Button class="self-center lg:self-start" link="#schedule-call-section">Get started</Button>
      </div>
    </div>
  </section>
  <section class="flex flex-col items-center px-32 md:px-53 lg:px-59 py-59 bg-blue gap-36">
    <H2 color="parchment">A new website with <span class="text-electric">little effort</span></H2>
    <div class="grow-1 flex flex-col gap-22 max-w-559 md:max-w-617">
      <Text class="text-parchment">
        When you sign up for our website design service, you can get a new website <span class='text-electric font-semibold'>easy</span>.
      </Text>
      <div class="flex flex-col gap-14">
        <div class="flex gap-18 ps-18">
          <div class="pt-8 md:pt-11 lg:pt-12">
            <svg width="8" height="8" viewBox="0 0 8 8" fill="none" xmlns="http://www.w3.org/2000/svg">
              <circle cx="4" cy="4" r="4" fill="#FFF7EB"/>
            </svg>
          </div>
          <Text class='text-parchment'>We don’t make you write the content.</Text>
        </div>
        <div class="flex gap-18 ps-18">
          <div class="pt-8 md:pt-11 lg:pt-12">
            <svg width="8" height="8" viewBox="0 0 8 8" fill="none" xmlns="http://www.w3.org/2000/svg">
              <circle cx="4" cy="4" r="4" fill="#FFF7EB"/>
            </svg>
          </div>
          <Text class='text-parchment'>We take the responsibility of choosing the right photos. (either using yours or getting them ourselves)</Text>
        </div>
        <div class="flex gap-18 ps-18">
          <div class="pt-8 md:pt-11 lg:pt-12">
            <svg width="8" height="8" viewBox="0 0 8 8" fill="none" xmlns="http://www.w3.org/2000/svg">
              <circle cx="4" cy="4" r="4" fill="#FFF7EB"/>
            </svg>
          </div>
          <Text class='text-parchment'>We brainstorm how to put the content into an engaging design.</Text>
        </div>
      </div>
      <Text class="text-parchment">
        And for any small tasks you may need to complete, we will be there to help you.
      </Text>
    </div>
  </section>
  <section class="flex flex-col items-center px-32 md:px-53 lg:px-95 py-59 gap-53 md:gap-59">
    <H2 class="text-center">The game plan for your new website</H2>
    <div class="relative grow-1 flex flex-col gap-53 md:gap-95 md:py-36 max-w-559 md:max-w-750 lg:max-w-960 xl:max-w-1145">
      <div class='game-plan-line absolute -z-1 w-3 md:w-5 bg-spark translate-x-[1.59375rem] md:translate-x-[2.5625rem] lg:translate-x-[2.96875rem]'></div>
      <div class="flex flex-row gap-20 md:gap-59">
        <div class="shrink-0 flex items-center justify-center h-54 md:h-87 lg:h-100 w-54 md:w-87 lg:w-100 border-3 md:border-5 border-spark rounded-full bg-parchment">
          <p class="number-in-circle text-21 md:text-40/[150%] lg:text-61/[150%] font-semibold text-spark">1</p>
        </div>
        <div class="flex flex-col gap-5">
          <H3>Plan</H3>
          <Text>
            Join a meeting with us to get a plan for your website. 
            We want to understand your goals and your business 
            so we can get you the exact results you’re looking for.
          </Text>
        </div>
      </div>
      <div class="flex flex-row gap-20 md:gap-59">
        <div class="shrink-0 flex items-center justify-center h-54 md:h-87 lg:h-100 w-54 md:w-87 lg:w-100 border-3 md:border-5 border-spark rounded-full bg-parchment">
          <p class="number-in-circle text-21 md:text-40/[150%] lg:text-61/[150%] font-semibold text-spark">2</p>
        </div>
        <div class="flex flex-col gap-5">
          <H3>Execute</H3>
          <Text>
            This is our part. We now put the plan into action. 
            We carefully design and build your new website to have a higher conversion rate.
          </Text>
        </div>
      </div>
      <div class="flex flex-row gap-20 md:gap-59 bg-parchment">
        <div class="shrink-0 flex items-center justify-center h-54 md:h-87 lg:h-100 w-54 md:w-87 lg:w-100 border-3 md:border-5 border-spark rounded-full">
          <p class="number-in-circle text-21 md:text-40/[150%] lg:text-61/[150%] font-semibold text-spark">3</p>
        </div>
        <div class="flex flex-col gap-5">
          <H3>Celebrate</H3>
          <Text>
            Your website is complete! Now it is time to celebrate this milestone, 
            and you can now be proud of the website you have.
          </Text>
        </div>
      </div>
    </div>
    <Button class="self-center" link="#schedule-call-section">Get started</Button>
  </section>
  <section class="flex flex-col items-center px-32 md:px-53 py-95 gap-95 bg-charcoal">
    <div class="grow-1 flex flex-col items-center gap-59 lg:gap-95 max-w-559 lg:max-w-633">
      <H2 class="text-center text-electric">Custom website design</H2>
      <div class="flex flex-col items-center gap-59">
        <div class="flex flex-col gap-20 md:gap-36 px-20 md:px-36 py-32 md:py-36 bg-blue border-2 border-electric rounded-md">
          <p class="text-23 md:text-28 lg:text-36 text-parchment font-semibold text-center">$2995</p>
          <div class="flex flex-col gap-14">
            <div class="flex flex-row gap-9">
              <svg class='shrink-0 md:w-32 md:h-32' xmlns="http://www.w3.org/2000/svg" height="24px" viewBox="0 -960 960 960" width="24px" fill="#FFF7EB"><path d="M382-240 154-468l57-57 171 171 367-367 57 57-424 424Z"/></svg>
              <div class="flex flex-col gap-2 md:py-1 lg:py-0">
                <h3 class="text-16 md:text-19 lg:text-21 font-semibold text-electric">Custom, engaging design</h3>
                <p class="text-parchment text-16 lg:text-19">
                  You get a custom-designed website, not a template. A design created to be engaging and appealing.
                </p>
              </div>
            </div>
            <div class="flex flex-row gap-9">
